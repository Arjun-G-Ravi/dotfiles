{
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["custom/vpn", "network", "bluetooth", "pulseaudio", "battery", "custom/stats", "clock"],

  "custom/vpn": {
    "format": "{}",
    "interval": 3,
    "return-type": "json",
    // "exec": "VPN_NAME=$(nmcli -t -f NAME,TYPE connection show --active | grep -i 'proton' | head -n1 | cut -d: -f1); COUNTRY_CODE=$(echo $VPN_NAME | awk '{print $2}' | cut -d'-' -f1); case \"$COUNTRY_CODE\" in CA) COUNTRY='Canada';; JP) COUNTRY='Japan';; MX) COUNTRY='Mexico';; NL) COUNTRY='Netherlands';; NO) COUNTRY='Norway';; PL) COUNTRY='Poland';; RO) COUNTRY='Romania';; SG) COUNTRY='Singapore';; CH) COUNTRY='Switzerland';; US) COUNTRY='United States';; *) COUNTRY='Unknown';; esac; if [ -n \"$VPN_NAME\" ]; then echo \"{\\\"text\\\": \\\"<span size='13000' foreground='#a6e3a1'>🛡️($COUNTRY)</span>\\\", \\\"tooltip\\\": \\\" $VPN_NAME ($COUNTRY)\\\"}\"; else echo \"{\\\"text\\\": \\\"<span size='13000' foreground='#eba0ac'>🛡️❌</span>\\\", \\\"tooltip\\\": \\\"VPN Disconnected\\\"}\"; fi",
    "exec": "VPN_NAME=$(nmcli -t -f NAME,TYPE connection show --active | grep -i 'proton' | head -n1 | cut -d: -f1); COUNTRY_CODE=$(echo $VPN_NAME | awk '{print $2}' | cut -d'-' -f1); DEV=proton0; RX=$(cat /sys/class/net/$DEV/statistics/rx_bytes 2>/dev/null); TX=$(cat /sys/class/net/$DEV/statistics/tx_bytes 2>/dev/null); RX_MB=$(awk \"BEGIN {printf \\\"%.2f\\\", $RX/1024/1024}\"); TX_MB=$(awk \"BEGIN {printf \\\"%.2f\\\", $TX/1024/1024}\"); case \"$COUNTRY_CODE\" in CA) COUNTRY='Canada';; JP) COUNTRY='Japan';; MX) COUNTRY='Mexico';; NL) COUNTRY='Netherlands';; NO) COUNTRY='Norway';; PL) COUNTRY='Poland';; RO) COUNTRY='Romania';; SG) COUNTRY='Singapore';; CH) COUNTRY='Switzerland';; US) COUNTRY='United States';; *) COUNTRY='Unknown';; esac; if [ -n \"$VPN_NAME\" ]; then echo \"{\\\"text\\\": \\\"<span size='13000' foreground='#a6e3a1'>🛡️($COUNTRY)</span>\\\", \\\"tooltip\\\": \\\"$VPN_NAME \\nRX: $RX_MB MB\\nTX: $TX_MB MB\\\"}\"; else echo \"{\\\"text\\\": \\\"<span size='13000' foreground='#eba0ac'>🛡️❌</span>\\\", \\\"tooltip\\\": \\\"VPN Disconnected\\\"}\"; fi",
    "on-click": "protonvpn-app"
  },


  "clock": {
    "format": "<span foreground='#f5c2e7'></span>{:%d %B (%a) %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>",
    "on-click": "gnome-calendar"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#a6e3a1'>{icon} </span> {capacity}%",
    "format-warning": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {capacity}%",
    "format-critical": "<span size='13000' foreground='#E38C8F'>{icon} </span> {capacity}%",
    "format-charging": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
    "format-plugged": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
    "format-alt": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {time}",
    "format-full": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}"
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#f5e0dc'>🛜</span>",
    "format-ethernet": "<span size='13000' foreground='#f5e0dc'>🛜(vpn)</span>",
    "format-linked": "<span size='13000' foreground='#f5e0dc'>:0</span>",
    "format-disconnected": "<span size='13000' foreground='#f5e0dc'>🛜❌</span>",
    "tooltip-format-wifi": "{essid} - Signal: {signalStrength}%",
    "tooltip-format-ethernet": "Ethernet Connected",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "alacritty -e nmtui"
  },
  "bluetooth": {
    "format": "<span size='13000' foreground='#89b4fa'>🔗❌</span>",
    "format-disabled": "<span size='13000' foreground='#6c7086'>🔗❌</span>",
    "format-off": "<span size='13000' foreground='#6c7086'>🔗❌</span>",
    "format-connected": "<span size='13000' foreground='#a6e3a1'>🔗</span>",
    "tooltip-format": "{status}",
    "tooltip-format-connected": "Connected: {device_alias}",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "<span size='13000'>{icon}</span>",
    "format-muted": "<span size='13000'>🔊❌</span>",
    "format-icons": {
      "default": ["🔈", "🔉", "🔊"]
    },
    "tooltip-format": "Volume: {volume}%",
    "on-click": "pavucontrol --tab=3"
  },
  "custom/stats": {
    "format": "<span size='13000' foreground='#fab387'>🖥️</span>",
    "tooltip": true,
    "exec": "echo 'CPU: '$(~/.config/waybar/helper/cpu_usage.sh)' | RAM: '$(~/.config/waybar/helper/memory_used.sh)' | GPU: '$(~/.config/waybar/helper/gpu_usage.sh)' | VRAM: '$(~/.config/waybar/helper/gpu_memory.sh)",
    "interval": 2,
    "tooltip-format": " {}",
    "on-click": "alacritty -e btop"
  }

}